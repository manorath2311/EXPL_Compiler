Terminals unused in grammar

    AND
    OR


Grammar

    0 $accept: program $end

    1 program: TypeDefBlock GDeclBlock FDefBlock MainBlock
    2        | TypeDefBlock GDeclBlock MainBlock

    3 TypeDefBlock: TYPE TypeDefList ENDTYPE
    4             | TYPE ENDTYPE

    5 TypeDefList: TypeDefList TypeDef
    6            | TypeDef

    7 TypeDef: UserDefinedType '{' FieldDeclList '}'

    8 UserDefinedType: ID

    9 FieldDeclList: FieldDeclList FieldDecl
   10              | FieldDecl

   11 FieldDecl: FieldType ID ';'

   12 GDeclBlock: DECL GDeclList ENDDECL
   13           | DECL ENDDECL
   14           | ε

   15 GDeclList: GDeclList GDecl
   16          | GDecl

   17 GDecl: Type GIdList ';'

   18 FieldType: INT
   19          | STR
   20          | ID

   21 Type: INT
   22     | STR
   23     | ID

   24 FType: INT
   25      | STR
   26      | ID

   27 GIdList: GIdList ',' GId
   28        | GId

   29 GId: ID '(' ParamList ')'
   30    | ID
   31    | ID '[' NUM ']'

   32 FDefBlock: FDefBlock FDef
   33          | FDef

   34 FDef: Type ID '(' ParamList ')' '{' LDeclBlock Body '}'

   35 ParamList: ParamList ',' Param
   36          | Param
   37          | ε

   38 Param: FType ID

   39 MainBlock: Type MAIN '(' ')' '{' LDeclBlock Body '}'

   40 LDeclBlock: DECL LDecList ENDDECL
   41           | DECL ENDDECL
   42           | ε

   43 LDecList: LDecList LDecl
   44         | LDecl

   45 LDecl: FType IdList ';'

   46 IdList: IdList ',' LId
   47       | LId

   48 LId: ID

   49 Body: START Slist RetStmt END
   50     | START RetStmt END

   51 RetStmt: RETURN expr ';'

   52 Field: ID '.' ID
   53      | Field '.' ID

   54 Slist: Slist Stmt
   55      | Stmt

   56 Stmt: InputStmt
   57     | OutputStmt
   58     | AsgStmt
   59     | IfStmt
   60     | WhileStmt
   61     | BrkStmt
   62     | ContStmt
   63     | func ';'
   64     | FREE '(' ID ')' ';'
   65     | FREE '(' Field ')' ';'
   66     | INIT '(' ')' ';'

   67 IfStmt: IF '(' expr ')' THEN Slist ELSE Slist ENDIF ';'
   68       | IF '(' expr ')' THEN Slist ENDIF ';'

   69 WhileStmt: WHILE '(' expr ')' DO Slist ENDWHILE ';'

   70 BrkStmt: BREAK ';'

   71 ContStmt: CONT ';'

   72 InputStmt: READ '(' id ')' ';'
   73          | READ '(' Field ')' ';'

   74 OutputStmt: WRITE '(' expr ')' ';'

   75 AsgStmt: ID ASSGN expr ';'
   76        | Field ASSGN ALLOC '(' ')' ';'
   77        | ID ASSGN ALLOC '(' ')' ';'
   78        | Field ASSGN expr ';'
   79        | ID ASSGN NILL ';'
   80        | Field ASSGN NILL ';'

   81 ExprList: ExprList ',' expr
   82         | expr
   83         | ε

   84 expr: expr PLUS expr
   85     | expr MINUS expr
   86     | expr MUL expr
   87     | expr DIV expr
   88     | expr MOD expr
   89     | expr LT expr
   90     | expr GT expr
   91     | expr LE expr
   92     | expr GE expr
   93     | expr NEQ expr
   94     | expr EQ expr
   95     | Field DEQNILL
   96     | Field NEQNILL
   97     | ID DEQNILL
   98     | ID NEQNILL
   99     | '(' expr ')'
  100     | NUM
  101     | MINUS NUM
  102     | STRVAL
  103     | id
  104     | func
  105     | Field

  106 func: ID '(' ExprList ')'

  107 id: ID
  108   | ID '[' NUM ']'
  109   | ID '[' id ']'


